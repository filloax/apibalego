{
  "schemaVersion": 1,
  "id": "apibalego",
  "version": "${version_prefix}-fabric",
  "name": "${mod_name}",
  "description": "Generic gamemaster/website connection layer extracted from Ruins of Growsseth.",
  "authors": [
    "Filloax"
  ],
  "contact": {
    "homepage": "https://github.com/filloax/ruins-of-growsseth",
    "issues": "https://github.com/filloax/ruins-of-growsseth/issues",
    "source": "https://github.com/filloax/ruins-of-growsseth"
  },
  "license": "MIT",
  "icon": "assets/apibalego/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "com.ruslan.apibalego.ApiBalegoFabric",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "com.ruslan.apibalego.ApiBalegoFabricClient",
        "adapter": "kotlin"
      }
    ]
  },
  "depends": {
    "filloaxlib": ">=${filloaxlib_version}",
    "resourcefulconfig": ">=${rconfig_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fapi_version}",
    "minecraft": "${fabric_minecraft_version_range}"
  }
}
